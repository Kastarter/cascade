+
+async fn resolve_audio_devices_for_capture_without_prompting_screen_capture(
+    config: &RecordingConfig,
+    screen_capture_ready: bool,
+) -> Vec<String> {
+    #[cfg(target_os = "macos")]
+    {
+        if !screen_capture_ready {
+            if should_resolve_to_system_default_audio(
+                &config.audio_devices,
+                config.use_system_default_audio,
+            ) {
+                let devices = default_input_device()
+                    .map(|device| vec![device.to_string()])
+                    .unwrap_or_else(|error| {
+                        warn!(
+                            "Screen Recording is denied and default input audio could not be resolved: {}",
+                            error
+                        );
+                        Vec::new()
+                    });
+                warn!(
+                    "Screen Recording is denied; system audio capture is disabled until permission is granted"
+                );
+                return devices;
+            }
+
+            let mut devices = resolve_audio_devices_for_capture(&config.audio_devices, false).await;
+            let before = devices.len();
+            devices.retain(|device| !is_output_audio_device_label(device));
+            if before != devices.len() {
+                warn!(
+                    "Screen Recording is denied; removed {} system/output audio device(s) from capture config",
+                    before - devices.len()
+                );
+            }
+            return devices;
+        }
+    }
+
+    resolve_audio_devices_for_capture(&config.audio_devices, config.use_system_default_audio).await
+}
+
+#[cfg(target_os = "macos")]
+fn is_output_audio_device_label(device: &str) -> bool {
+    let normalized = device.trim().to_ascii_lowercase();
+    normalized.ends_with("(output)") || normalized == "system audio"
+}
