+
+#[cfg(target_os = "macos")]
+mod macos_permission_flow {
+    use super::OSPermission;
+    use once_cell::sync::Lazy;
+    use std::{
+        collections::HashMap,
+        path::PathBuf,
+        process::Command,
+        sync::{
+            atomic::{AtomicBool, Ordering},
+            Mutex,
+        },
+        time::{Duration, Instant},
+    };
+    use tracing::{debug, warn};
+
+    // Clicky/OpenClicky/TipTour use one native prompt first, then Settings on a
+    // later attempt. Opening both on the same click makes System Settings stack.
+    static SCREEN_PROMPT_ATTEMPTED: AtomicBool = AtomicBool::new(false);
+    static ACCESSIBILITY_PROMPT_ATTEMPTED: AtomicBool = AtomicBool::new(false);
+    static INPUT_MONITORING_PROMPT_ATTEMPTED: AtomicBool = AtomicBool::new(false);
+    static SETTINGS_LAST_OPENED: Lazy<Mutex<HashMap<&'static str, Instant>>> =
+        Lazy::new(|| Mutex::new(HashMap::new()));
+    const SETTINGS_OPEN_COOLDOWN: Duration = Duration::from_secs(8);
+
+    fn permission_key(permission: &OSPermission) -> &'static str {
+        match permission {
+            OSPermission::ScreenRecording => "screenRecording",
+            OSPermission::Microphone => "microphone",
+            OSPermission::Accessibility => "accessibility",
+            OSPermission::Automation => "automation",
+            OSPermission::InputMonitoring => "inputMonitoring",
+        }
+    }
+
+    pub fn settings_url(permission: &OSPermission) -> &'static str {
+        match permission {
+            OSPermission::ScreenRecording => {
+                "x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture"
+            }
+            OSPermission::Microphone => {
+                "x-apple.systempreferences:com.apple.preference.security?Privacy_Microphone"
+            }
+            OSPermission::Accessibility => {
+                "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"
+            }
+            OSPermission::Automation => {
+                "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation"
+            }
+            OSPermission::InputMonitoring => {
+                "x-apple.systempreferences:com.apple.preference.security?Privacy_ListenEvent"
+            }
+        }
+    }
+
+    pub fn should_use_system_prompt(permission: &OSPermission) -> bool {
+        match permission {
+            OSPermission::ScreenRecording => {
+                !SCREEN_PROMPT_ATTEMPTED.swap(true, Ordering::SeqCst)
+            }
+            OSPermission::Accessibility => {
+                !ACCESSIBILITY_PROMPT_ATTEMPTED.swap(true, Ordering::SeqCst)
+            }
+            OSPermission::InputMonitoring => {
+                !INPUT_MONITORING_PROMPT_ATTEMPTED.swap(true, Ordering::SeqCst)
+            }
+            OSPermission::Microphone | OSPermission::Automation => true,
+        }
+    }
+
+    fn current_app_bundle() -> Option<PathBuf> {
+        let mut path = std::env::current_exe().ok()?;
+        loop {
+            if path.extension().and_then(|ext| ext.to_str()) == Some("app") {
+                return Some(path);
+            }
+            if !path.pop() {
+                return None;
+            }
+        }
+    }
+
+    pub fn reveal_current_app_in_finder() {
+        let Some(bundle_path) = current_app_bundle() else {
+            warn!("Could not locate current .app bundle to reveal in Finder");
+            return;
+        };
+
+        if let Err(error) = Command::new("open").arg("-R").arg(&bundle_path).spawn() {
+            warn!(
+                "Failed to reveal current app bundle in Finder ({}): {}",
+                bundle_path.display(),
+                error
+            );
+        }
+    }
+
+    fn should_reveal_app(permission: &OSPermission) -> bool {
+        matches!(
+            permission,
+            OSPermission::ScreenRecording
+                | OSPermission::Accessibility
+                | OSPermission::InputMonitoring
+        )
+    }
+
+    pub fn open_settings(permission: &OSPermission) -> bool {
+        let key = permission_key(permission);
+        {
+            let mut last_opened = match SETTINGS_LAST_OPENED.lock() {
+                Ok(guard) => guard,
+                Err(poisoned) => poisoned.into_inner(),
+            };
+            if let Some(previous) = last_opened.get(key) {
+                if previous.elapsed() < SETTINGS_OPEN_COOLDOWN {
+                    debug!(
+                        "Skipping duplicate macOS privacy settings open for {}",
+                        key
+                    );
+                    return false;
+                }
+            }
+            last_opened.insert(key, Instant::now());
+        }
+
+        if let Err(error) = Command::new("open").arg(settings_url(permission)).spawn() {
+            warn!(
+                "Failed to open macOS privacy settings for {}: {}",
+                key, error
+            );
+            return false;
+        }
+
+        if should_reveal_app(permission) {
+            reveal_current_app_in_finder();
+        }
+
+        true
+    }
 }
 
