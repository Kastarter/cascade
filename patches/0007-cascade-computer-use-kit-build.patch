+/// Compile computer_use_kit.swift into a static library for Cascade's native
+/// macOS real-screen computer-use driver.
+#[cfg(target_os = "macos")]
+fn build_computer_use_kit() {
+    use std::path::PathBuf;
+    use std::process::Command;
+
+    let out_dir = PathBuf::from(std::env::var("OUT_DIR").unwrap());
+    let swift_src = PathBuf::from("swift/computer_use_kit.swift");
+    let lib_path = out_dir.join("libcomputer_use_kit.a");
+
+    println!("cargo:rerun-if-changed=swift/computer_use_kit.swift");
+
+    if !swift_src.exists() {
+        println!("cargo:warning=swift/computer_use_kit.swift not found, building stub");
+        build_computer_use_kit_stub(&out_dir, &lib_path);
+        return;
+    }
+
+    let has_sck = has_screencapturekit_sdk();
+    println!("cargo:warning=ScreenCaptureKit SDK check: {}", has_sck);
+    if !has_sck {
+        println!("cargo:warning=ScreenCaptureKit.framework not found in SDK, building ComputerUseKit stub");
+        build_computer_use_kit_stub(&out_dir, &lib_path);
+        return;
+    }
+
+    let sdk_path = Command::new("xcrun")
+        .args(["--sdk", "macosx", "--show-sdk-path"])
+        .output()
+        .ok()
+        .and_then(|o| String::from_utf8(o.stdout).ok())
+        .unwrap_or_default();
+    let sdk_path = sdk_path.trim().to_string();
+
+    let target_arch =
+        std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_else(|_| "aarch64".to_string());
+    let swift_target = if target_arch == "x86_64" {
+        "x86_64-apple-macos13.0"
+    } else {
+        "arm64-apple-macos13.0"
+    };
+
+    let output = Command::new("swiftc")
+        .args([
+            "-emit-library",
+            "-static",
+            "-module-name",
+            "ComputerUseKit",
+            "-swift-version",
+            "5",
+            "-sdk",
+            &sdk_path,
+            "-target",
+            swift_target,
+            "-O",
+            "-whole-module-optimization",
+            "-o",
+        ])
+        .arg(&lib_path)
+        .arg(&swift_src)
+        .output()
+        .expect("failed to run swiftc for computer_use_kit");
+
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        println!(
+            "cargo:warning=swiftc failed for computer_use_kit.swift: {}",
+            stderr.chars().take(500).collect::<String>()
+        );
+        build_computer_use_kit_stub(&out_dir, &lib_path);
+        return;
+    }
+
+    println!("cargo:rustc-link-search=native={}", out_dir.display());
+    println!("cargo:rustc-link-lib=static=computer_use_kit");
+    println!("cargo:rustc-link-lib=framework=ApplicationServices");
+    println!("cargo:rustc-link-lib=framework=CoreGraphics");
+    println!("cargo:rustc-link-arg=-Wl,-weak_framework,ScreenCaptureKit");
+}
+
+/// Build a tiny C stub that exports the ComputerUseKit C ABI when the Swift
+/// implementation is unavailable.
+#[cfg(target_os = "macos")]
+fn build_computer_use_kit_stub(out_dir: &std::path::Path, lib_path: &std::path::Path) {
+    use std::process::Command;
+
+    let stub_src = out_dir.join("computer_use_kit_stub.c");
+    std::fs::write(
+        &stub_src,
+        r#"// Stub: Cascade ComputerUseKit not available
+#include <stdlib.h>
+#include <string.h>
+
+static char* cu_make_string(const char* s) {
+    char* p = malloc(strlen(s) + 1);
+    if (p) strcpy(p, s);
+    return p;
+}
+
+char* cu_status_json(void) {
+    return cu_make_string("{\"ok\":true,\"data\":{\"available\":false,\"screenCaptureAvailable\":false,\"screenRecordingGranted\":false,\"accessibilityGranted\":false,\"inputMonitoringLikelyGranted\":false,\"visibleWindowCount\":0,\"missing\":[\"ComputerUseKit\"]}}");
+}
+
+char* cu_observe_json(const char* config_json) {
+    (void)config_json;
+    return cu_make_string("{\"ok\":false,\"error\":\"ComputerUseKit not available\"}");
+}
+
+char* cu_act_json(const char* action_json) {
+    (void)action_json;
+    return cu_make_string("{\"ok\":false,\"error\":\"ComputerUseKit not available\"}");
+}
+
+void cu_free_string(char* ptr) { if (ptr) free(ptr); }
+"#,
+    )
+    .expect("failed to write computer use kit stub");
+
+    let target_arch =
+        std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_else(|_| "aarch64".to_string());
+    let cc_arch = if target_arch == "x86_64" {
+        "x86_64"
+    } else {
+        "arm64"
+    };
+    let status = Command::new("cc")
+        .args(["-c", "-arch", cc_arch, "-o"])
+        .arg(out_dir.join("computer_use_kit_stub.o").to_str().unwrap())
+        .arg(stub_src.to_str().unwrap())
+        .status()
+        .expect("failed to compile computer use kit stub");
+    assert!(status.success(), "computer use kit stub compilation failed");
+
+    let status = Command::new("ar")
+        .args(["rcs"])
+        .arg(lib_path)
+        .arg(out_dir.join("computer_use_kit_stub.o").to_str().unwrap())
+        .status()
+        .expect("failed to create computer use kit stub archive");
+    assert!(status.success(), "computer use kit stub archive failed");
+
+    println!("cargo:rustc-link-search=native={}", out_dir.display());
+    println!("cargo:rustc-link-lib=static=computer_use_kit");
+}
