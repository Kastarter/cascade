+fn fix_path_env_with_timeout() {
+    let (tx, rx) = std::sync::mpsc::channel();
+    std::thread::spawn(move || {
+        let result = fix_path_env::fix().map_err(|e| e.to_string());
+        let _ = tx.send(result);
+    });
+
+    match rx.recv_timeout(std::time::Duration::from_secs(3)) {
+        Ok(Ok(())) => {}
+        Ok(Err(error)) => eprintln!("fix_path_env failed: {error}"),
+        Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {
+            eprintln!("fix_path_env timed out after 3s; continuing with current PATH");
+        }
+        Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => {
+            eprintln!("fix_path_env worker exited before returning a result");
+        }
+    }
+}
+
 #[tokio::main]
 async fn main() {
-    let _ = fix_path_env::fix();
+    fix_path_env_with_timeout();
 
     #[cfg(target_os = "windows")]
     windows_webview_env::install_user_data_dir();
