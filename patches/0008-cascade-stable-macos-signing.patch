@@ -1,20 +1,28 @@
-#!/bin/bash
-set -e
+#!/usr/bin/env bash
+set -euo pipefail
 
-# Clean up any existing bundle
 rm -rf src-tauri/target/release/bundle
 
-# Build without signing
-bun tauri build --no-sign
+IDENTITY="${CASCADE_SIGNING_IDENTITY:-${APPLE_SIGNING_IDENTITY:-}}"
+if [[ -z "$IDENTITY" ]]; then
+  IDENTITY="$(bash scripts/cascade_codesign_macos_app.sh --detect-identity || true)"
+fi
 
-# Strip extended attributes from all files in the bundle
-APP_PATH="src-tauri/target/release/bundle/macos/screenpipe - Development.app"
-xattr -cr "$APP_PATH"
+if [[ -n "$IDENTITY" ]]; then
+  CONFIG_FILE="$(mktemp)"
+  trap 'rm -f "$CONFIG_FILE"' EXIT
+  printf '{ "bundle": { "macOS": { "signingIdentity": "%s" } } }\n' "$IDENTITY" > "$CONFIG_FILE"
+  bun tauri build --config "$CONFIG_FILE" --skip-stapling
+else
+  echo "warning: no Apple code-signing identity found; building unsigned app"
+  bun tauri build --no-sign
+fi
 
-# Sign the app manually
-IDENTITY="Apple Development: Louis Beaumont (NJ372MT773)"
-codesign --force --deep --sign "$IDENTITY" "$APP_PATH"
+APP_PATH="$(find src-tauri/target/release/bundle/macos -maxdepth 1 -name 'Cascade.app' -print -quit)"
+if [[ -n "$APP_PATH" ]]; then
+  bash scripts/cascade_codesign_macos_app.sh "$APP_PATH"
+fi
 
 echo "Build completed successfully!"
