Index: screenpipe/apps/screenpipe-app-tauri/scripts/cascade_codesign_macos_app.sh
===================================================================
--- /dev/null
+++ screenpipe/apps/screenpipe-app-tauri/scripts/cascade_codesign_macos_app.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+detect_identity() {
+  local identities
+  identities="$(security find-identity -v -p codesigning 2>/dev/null || true)"
+
+  local identity
+  identity="$(printf '%s\n' "$identities" | awk -F\" '/Developer ID Application:/{ print $2; exit }')"
+  if [[ -n "$identity" ]]; then
+    printf '%s\n' "$identity"
+    return 0
+  fi
+
+  identity="$(printf '%s\n' "$identities" | awk -F\" '/Apple Development:/{ print $2; exit }')"
+  if [[ -n "$identity" ]]; then
+    printf '%s\n' "$identity"
+    return 0
+  fi
+
+  return 1
+}
+
+if [[ "${1:-}" == "--detect-identity" ]]; then
+  detect_identity
+  exit $?
+fi
+
+APP_PATH="${1:-}"
+if [[ -z "$APP_PATH" ]]; then
+  APP_PATH="$(find src-tauri/target -maxdepth 6 -path '*/bundle/macos/Cascade.app' -type d -print 2>/dev/null | sort | tail -n 1)"
+fi
+
+if [[ -z "$APP_PATH" || ! -d "$APP_PATH" ]]; then
+  echo "error: Cascade.app not found; pass the .app path explicitly" >&2
+  exit 1
+fi
+
+IDENTITY="${CASCADE_SIGNING_IDENTITY:-${APPLE_SIGNING_IDENTITY:-}}"
+if [[ -z "$IDENTITY" ]]; then
+  IDENTITY="$(detect_identity || true)"
+fi
+
+if [[ -z "$IDENTITY" ]]; then
+  echo "warning: no Apple code-signing identity found; leaving app unsigned" >&2
+  exit 0
+fi
+
+ENTITLEMENTS="$(cd "$(dirname "$0")/.." && pwd)/src-tauri/entitlements.plist"
+MAIN_EXECUTABLE="$(plutil -extract CFBundleExecutable raw -o - "$APP_PATH/Contents/Info.plist")"
+MAIN_PATH="$APP_PATH/Contents/MacOS/$MAIN_EXECUTABLE"
+
+echo "==> signing Cascade.app with: $IDENTITY"
+xattr -cr "$APP_PATH"
+
+while IFS= read -r -d '' helper; do
+  [[ "$helper" == "$MAIN_PATH" ]] && continue
+  codesign --force --timestamp=none --options runtime --sign "$IDENTITY" "$helper"
+done < <(find "$APP_PATH/Contents/MacOS" -type f -perm -111 -print0)
+
+codesign \
+  --force \
+  --timestamp=none \
+  --options runtime \
+  --entitlements "$ENTITLEMENTS" \
+  --sign "$IDENTITY" \
+  "$APP_PATH"
+
+codesign --verify --deep --strict --verbose=2 "$APP_PATH"
+codesign -dv --verbose=4 "$APP_PATH" 2>&1 | sed -n '1,24p'
Index: screenpipe/apps/screenpipe-app-tauri/scripts/build_macos.sh
