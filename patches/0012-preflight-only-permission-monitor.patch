+
+fn poll_permissions() -> PermissionSnapshot {
+    PermissionSnapshot {
+        // Strictly use the TCC preflight read for Screen Recording. The broader
+        // core check falls back to a real capture probe on false negatives,
+        // which is useful for CLI doctor flows but too aggressive for a
+        // background app permission monitor while access is denied.
+        screen_recording: check_screen_recording_preflight(),
+        microphone: check_microphone(),
+        accessibility: check_accessibility(),
+    }
+}
